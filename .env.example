# Telegram設定
TELEGRAM_TOKEN=1234567890:ABCDEFGabcdefg1234567890  # BotFatherから取得
TELEGRAM_CHAT_ID=-1001234567890                      # グループのchat_id（マイナスで始まる）

# 場所の設定（複数の場所は main.py の PLACES リストに追記）
PLACE_1_NAME=会社
PLACE_1_LAT=35.6895
PLACE_1_LON=139.6917
PLACE_1_RADIUS=200   # メートル

# 入退場の確定待ち時間（秒）。この秒数だけ状態変化が継続したら通知（チャタリング防止）
DEBOUNCE_SECONDS=180
